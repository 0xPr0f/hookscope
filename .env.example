# Copy only the values needed for the target environment. Every VITE_ value is
# public and is compiled into the browser bundle; use public or domain-restricted
# endpoints and credentials only. Repeat the numeric suffix for other chain IDs.
# Browser RPC overrides.
VITE_RPC_1=

# Index-first pool discovery. Configure either a token-sharded static index URL
# (placeholders: {chainId}, {chainSlug}, {token}) or a Uniswap v4 subgraph URL.
# The browser recomputes PoolIds and verifies PoolManager state at the pinned block.
VITE_V4_POOL_INDEX_1=https://cdn.example.com/uniswap-v4/v1/{chainId}/{token}.json
VITE_V4_SUBGRAPH_1=

# Optional completed-report persistence. DATABASE_URL is read only by Vercel
# Functions. Use the least-privilege Railway external/TCP-proxy connection URL,
# never a migration-owner URL, and never rename this to VITE_DATABASE_URL.
DATABASE_URL=
