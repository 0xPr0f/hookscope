# Copy only the values needed for the target environment. Every VITE_ value is
# public and is compiled into the browser bundle; use public or domain-restricted
# endpoints and credentials only.

# Browser RPC overrides. Repeat the numeric suffix for other chain IDs. A
# credentialed archive endpoint is what unlocks deep execution on chains whose
# public RPC refuses historical state.
VITE_RPC_1=

# Index-first pool discovery through The Graph's decentralized gateway.
# One key serves every chain; the per-chain subgraph IDs are public and live in
# src/config/subgraphs.ts, not here.
#
# Server-side, and the recommended setting: read only by the /api/subgraph proxy,
# so the key never enters the browser bundle. No VITE_ prefix, by design.
SUBGRAPH_API_KEY=

# Alternative that skips the proxy by querying the gateway directly from the
# browser. The key is then compiled into the bundle and must be domain-restricted
# in The Graph's dashboard. Leave unset to keep the key server-side.
VITE_GRAPH_API_KEY=

# Optional per-chain override for a private or self-hosted indexer. When set it
# wins over the gateway URL built from VITE_GRAPH_API_KEY.
VITE_V4_SUBGRAPH_1=

# Optional completed-report persistence. DATABASE_URL is read only by Vercel
# Functions. Use the least-privilege Railway external/TCP-proxy connection URL,
# never a migration-owner URL, and never rename this to VITE_DATABASE_URL.
DATABASE_URL=
