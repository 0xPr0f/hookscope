{
  "name": "hookscope",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run && pnpm test:tooling",
    "test:watch": "vitest",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "test:e2e": "playwright test",
    "test:foundry": "forge test --root . -vv",
    "canary:chains": "node scripts/chain-canary.mjs",
    "pool-index:generate": "node scripts/generate-pool-index.mjs",
    "pool-index:validate": "node scripts/validate-pool-index.mjs",
    "wasm:build": "pnpm wasm:build:revm && pnpm wasm:build:fuzz",
    "wasm:build:revm": "wasm-pack build crates/revm-wasm --target web --out-dir ../../src/wasm/revm --release",
    "wasm:build:fuzz": "wasm-pack build crates/revm-wasm --target web --out-dir ../../src/wasm/fuzz --release --features libafl-fuzz",
    "verify": "pnpm lint && pnpm test && pnpm test:foundry && pnpm build"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@shazow/whatsabi": "0.15.3",
    "@tanstack/react-query": "5.90.2",
    "evmole": "0.9.3",
    "lucide-react": "0.468.0",
    "postgres": "3.4.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sevm": "0.7.4",
    "viem": "2.38.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@playwright/test": "1.56.1",
    "@types/node": "24.8.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@uniswap/v4-core": "1.0.2",
    "@uniswap/v4-periphery": "1.0.3",
    "@vercel/node": "5.5.20",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.38.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.20.0"
}
